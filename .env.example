# Copy to .env. Frontend dev server
PORT=24010
ALLOWED_HOSTS=
# Port the Vite dev server forwards /api to (the `npm run dev:api` port).
API_PORT=24011
# Playwright target for `npm run test:e2e` (e.g. a `vite preview` URL); empty uses the config default.
PLAYWRIGHT_BASE_URL=

# Backend (Cloudflare Pages Functions). Never prefix with VITE_.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=
# 1Click partner key from https://partners.near-intents.org (optional; without it 1Click adds 25 bps).
ONECLICK_API_KEY=
ONECLICK_BASE_URL=https://1click.chaindefuser.com
NEAR_RPC_URL=https://rpc.mainnet.fastnear.com
# Origin used in emailed payment links (e.g. https://frenzypay.app). Empty: the origin of the request that sent it.
PUBLIC_BASE_URL=

# --- Invoice email (server/email.ts, SMTP via worker-mailer) ---
# Sending is off ("Email is not configured" in the UI) unless SMTP_HOST, SMTP_USER, SMTP_PASS and MAIL_FROM are all set.
# Mailtrap: live.smtp.mailtrap.io port 587 (real sending), sandbox.smtp.mailtrap.io port 2525 (inbox testing); both STARTTLS.
# SMTP_PASS is a secret: real value only in .env (local) or a Cloudflare secret (deploy). Never prefix any of these with VITE_.
# SMTP server hostname.
SMTP_HOST=
# SMTP port; empty means 587.
SMTP_PORT=587
# SMTP username (Mailtrap: "api" for live sending, the inbox username for the sandbox).
SMTP_USER=
# SMTP password or API token. Secret.
SMTP_PASS=
# starttls (587/2525, default), tls (implicit TLS, usually 465) or none (local test servers only).
SMTP_SECURE=starttls
# Sender, e.g. FrenzyPay <invoice@yourdomain>; the domain must be verified with your SMTP provider.
MAIL_FROM=
# Optional Reply-To address for client replies.
MAIL_REPLY_TO=

# --- On-chain public records (server/chain.ts, contracts/frenzypay, scripts/deploy-contract.sh) ---
# Setup steps: scripts/setup-mainnet.md. Nothing is written on-chain unless CHAIN_WRITES_ENABLED=true AND
# CONTRACT_ID, RELAYER_ACCOUNT_ID, RELAYER_PUBLIC_KEY and RELAYER_PRIVATE_KEY are all set. Never prefix with VITE_.
# mainnet or testnet; picks the explorer (nearblocks.io / testnet.nearblocks.io) and the deploy target. RPC is NEAR_RPC_URL above.
NEAR_NETWORK=mainnet
# The contract account, a subaccount (e.g. frenzypay.maxkumbang.near), never the owner's main wallet. Also enables pay-link reads from chain.
CONTRACT_ID=
# Account that owns the contract (init owner_id); used by the setup/deploy scripts, not by the server.
CONTRACT_OWNER_ID=
# Whitelisted relayer account the server signs as (e.g. maxkumbang.near).
RELAYER_ACCOUNT_ID=
# ed25519:<base58> public key of RELAYER_PRIVATE_KEY; must be a function-call key on RELAYER_ACCOUNT_ID.
RELAYER_PUBLIC_KEY=
# Secret. ed25519:<base58> function-call key limited to CONTRACT_ID and its write methods. Real value only in .env or a Cloudflare secret.
RELAYER_PRIVATE_KEY=
# true only once the contract is deployed and you accept permanent public writes; anything else keeps writes off.
CHAIN_WRITES_ENABLED=false
# Optional build dir for scripts/deploy-contract.sh; empty means ~/.cache/frenzypay-contract-target (kept out of the repo).
CARGO_TARGET_DIR=
