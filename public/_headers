/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# The HTML's Content-Security-Policy carries a per-request nonce, so functions/_middleware.ts sets it
# (policy in server/csp.ts). Static files are served without Functions (public/_routes.json); this policy
# only matters if one is opened directly, e.g. an SVG.
/assets/*
  Content-Security-Policy: default-src 'none'; style-src 'unsafe-inline'; img-src 'self' data:; frame-ancestors 'none'

/img/*
  Content-Security-Policy: default-src 'none'; style-src 'unsafe-inline'; img-src 'self' data:; frame-ancestors 'none'
